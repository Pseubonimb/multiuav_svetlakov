+        // MultiUAV: сопротивление винтов (rotor drag). Лопасть, идущая навстречу потоку, тянет сильнее
+        // и отклоняется — получается сила против скорости поперёк оси винтов, пропорциональная тяге:
+        // F = -k * T * v. Её нет в исходном AirSim, поэтому дрон скользил, как по льду.
+        static Wrench getRotorDragWrench(const PhysicsBody& body, const Quaternionr& orientation,
+                                         const Wrench& body_wrench, const Vector3r& linear_vel, const Vector3r& wind_world)
+        {
+            Wrench wrench = Wrench::zero();
+            const real_T k = body.getRotorDragCoefficient();
+            if (k <= 0)
+                return wrench;
+            // body_wrench.force — сумма сил винтов в мировых осях; тяга направлена по -Z корпуса
+            const real_T thrust = std::max(0.0f, -VectorMath::transformToBodyFrame(body_wrench.force, orientation).z());
+            const Vector3r vel_body = VectorMath::transformToBodyFrame(linear_vel - wind_world, orientation);
+            const Vector3r force_body(-k * thrust * vel_body.x(), -k * thrust * vel_body.y(), 0);
+            wrench.force = VectorMath::transformToWorldFrame(force_body, orientation);
+            return wrench;
+        }
